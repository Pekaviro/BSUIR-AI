section_subject_domain_of_architecture = [*
	subject_domain_of_architecture 
		=> nrel_main_idtf: [Предметная область архитектуры] (* <- lang_ru;; *); [Subject domain of architecture] (* <- lang_en;; *);
		<- sc_node_struct;
		-> rrel_explored_relation: 
			nrel_architectural_style;
			nrel_material;
			nrel_era;
			nrel_architect;
			nrel_height;
		=> nrel_private_subject_domain: 
			subject_domain_of_architecture_of_public_buildings; 
			subject_domain_of_architecture_of_transport_structures; 
			subject_domain_of_architecture_of_sports_facilities; 
			subject_domain_of_architecture_of_cultural_objects; 
			subject_domain_of_architecture_of_religious_buildings;
		<- subject_domain;
		-> rrel_maximum_studied_object_class: concept_architecture;
		-> rrel_not_maximum_studied_object_class: 
			concept_building; 
			concept_temple; 
			concept_house; 
			concept_road; 
			concept_bridge;;
	*];;
	
nrel_material => nrel_main_idtf: [материал*] (* <- lang_ru;; *); [material*] (* <- lang_en;; *);;
nrel_era => nrel_main_idtf: [эпоха*] (* <- lang_ru;; *); [era*] (* <- lang_en;; *);;
nrel_architect => nrel_main_idtf: [архитектор*] (* <- lang_ru;; *); [architect*] (* <- lang_en;; *);;
nrel_height => nrel_main_idtf: [высота*] (* <- lang_ru;; *); [height*] (* <- lang_en;; *);;

subject_domain_of_architecture_of_public_buildings => nrel_main_idtf: [Предметная область архитектуры общественных зданий] (* <- lang_ru;; *); [Subject domain of architecture of public buildings] (* <- lang_en;; *);; 
subject_domain_of_architecture_of_transport_structures => nrel_main_idtf: [Предметная область архитектуры транспортных структур] (* <- lang_ru;; *); [Subject domain of architecture of transport structures] (* <- lang_en;; *);;
subject_domain_of_architecture_of_sports_facilities => nrel_main_idtf: [Предметная область архитектуры спортивных объектов] (* <- lang_ru;; *); [Subject domain of architecture of sports objects] (* <- lang_en;; *);; 
subject_domain_of_architecture_of_cultural_objects => nrel_main_idtf: [Предметная область архитектуры культурных объектов] (* <- lang_ru;; *); [Subject domain of architecture of cultural objects] (* <- lang_en;; *);; 
subject_domain_of_architecture_of_religious_buildings => nrel_main_idtf: [Предметная область архитектуры религиозных зданий] (* <- lang_ru;; *); [Subject domain of architecture of religious buildings] (* <- lang_en;; *);;
		
	
concept_architecture (* => nrel_main_idtf: [Архитектура] (* <- lang_ru;; *); [Architecture] (* <- lang_en;; *);;
	
concept_building => nrel_main_idtf: [Здание] (* <- lang_ru;; *); [Building] (* <- lang_en;; *);;

concept_house => nrel_main_idtf: [Дом] (* <- lang_ru;; *); [House] (* <- lang_en;; *);;

concept_road => nrel_main_idtf: [Дорога] (* <- lang_ru;; *); [Road] (* <- lang_en;; *);;

concept_bridge (* => nrel_main_idtf: [Мост] (* <- lang_ru;; *); [Bridge] (* <- lang_en;; *);;
		
section_subject_domain_of_architecture 
	=> nrel_main_idtf: [Раздел. Предметная область архитектуры] (* <- lang_ru;; *); [Section. Subject domain of architecture] (* <- lang_en;; *);
	-> nrel_section_decomposition: 
		section_subject_domain_of_architecture_of_public_buildings (* => nrel_main_idtf: [Раздел. Предметная область архитектуры общественных зданий] (* <- lang_ru;; *); [Section. Subject domain of architecture of public buildings] (* <- lang_en;; *);; *); 
		section_subject_domain_of_architecture_of_transport_structures (* => nrel_main_idtf: [Раздел. Предметная область архитектуры транспортных структур] (* <- lang_ru;; *); [Section. Subject domain of architecture of transport structures] (* <- lang_en;; *);; *); 
		section_subject_domain_of_architecture_of_sports_objects (* => nrel_main_idtf: [Раздел. Предметная область архитектуры спортивных объектов] (* <- lang_ru;; *); [Section. Subject domain of architecture of sports objects] (* <- lang_en;; *);; *);  
		section_subject_domain_of_architecture_of_cultural_objects (* => nrel_main_idtf: [Раздел. Предметная область архитектуры культурных объектов] (* <- lang_ru;; *); [Section. Subject domain of architecture of cultural objects] (* <- lang_en;; *);; *); 
		section_subject_domain_of_architecture_of_religious_buildings (* => nrel_main_idtf: [Раздел. Предметная область архитектуры религиозных зданий] (* <- lang_ru;; *); [Section. Subject domain of architecture of religious buildings] (* <- lang_en;; *);; *); 
	-> rrel_key_sc_element: nrel_architectural_style; nrel_material; nrel_era; nrel_architect; nrel_height; concept_architecture; concept_building; concept_temple; concept_house; concept_road; concept_bridge;
	<- non_atomic_section;;