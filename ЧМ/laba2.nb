Cell[BoxData[{
 RowBox[{
  RowBox[{"eps", "=", "0.001"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ex", "=", 
   RowBox[{"eps", "*", "10"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", "a", "]"}], "*", 
      RowBox[{
       RowBox[{"f", "''"}], "[", "a", "]"}]}], ">", "0"}], ",", 
    RowBox[{
     RowBox[{"xn0", "=", "b"}], ";", 
     RowBox[{
      RowBox[{"g", "[", "x_", "]"}], ":=", 
      RowBox[{"a", "-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"f", "[", "a", "]"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", "a"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"f", "[", "x", "]"}], "-", 
            RowBox[{"f", "[", "a", "]"}]}], ")"}]}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"hord", "[", 
       RowBox[{"x_", ",", "xn_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"f", "[", "xn", "]"}], "+", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", "xn"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"xn", "-", "a"}], ")"}]}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"f", "[", "xn", "]"}], "-", 
           RowBox[{"f", "[", "a", "]"}]}], ")"}]}], ")"}]}]}]}], ",", 
    RowBox[{
     RowBox[{"xn0", "=", "a"}], ";", 
     RowBox[{
      RowBox[{"g", "[", "x_", "]"}], ":=", 
      RowBox[{"x", "-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"f", "[", "x", "]"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"b", "-", "x"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"f", "[", "b", "]"}], "-", 
            RowBox[{"f", "[", "x", "]"}]}], ")"}]}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
