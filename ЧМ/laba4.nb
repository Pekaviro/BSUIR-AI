  3.941197970978922*^9}},ExpressionUUID->"737c69fc-3219-f54f-a5c4-\
de83c4315064"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"q2", "=", 
   FractionBox[
    RowBox[{"x", "-", "b"}], "h2"]}], ";", 
  RowBox[{
   RowBox[{"pn2", "[", "x_", "]"}], "=", 
   RowBox[{"dif2", "[", 
    RowBox[{"n2", ",", "0"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"p2", "[", "q_", "]"}], "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"k", "=", "1"}], ",", 
    RowBox[{"k", "\[LessEqual]", "n2"}], ",", 
    RowBox[{"k", "++"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"p2", "[", "q_", "]"}], "=", 
      RowBox[{
       RowBox[{"p2", "[", "q2", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"q2", "+", "k", "-", "1"}], ")"}]}]}], ";", 
     RowBox[{
      RowBox[{"pn2", "[", "x_", "]"}], "=", 
      RowBox[{
       RowBox[{"pn2", "[", "x", "]"}], "+", 
       RowBox[{
        FractionBox[
         RowBox[{"dif2", "[", 
          RowBox[{
           RowBox[{"n2", "-", "k"}], ",", "k"}], "]"}], 
         RowBox[{"k", "!"}]], " ", 
        RowBox[{"p2", "[", "q2", "]"}]}]}]}]}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pn2", "[", "x", "]"}], "//", "Simplify"}]}], "Input",
 CellChangeTimes->{{3.9411981718202972`*^9, 3.941198204715702*^9}, {
