Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"y", ",", "z"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rungeKuttaMethod", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y0_", ",", "z0_"}], "}"}], ",", " ", "h_", ",", "n_"}], "]"}], 
   ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "=", "a"}], ",", 
       RowBox[{"y", "=", "y0"}], ",", 
       RowBox[{"z", "=", "z0"}], ",", 
       RowBox[{"result", "=", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], "}"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"AppendTo", "[", 
       RowBox[{"result", ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", "n"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"k1y", ",", "k1z"}], "}"}], "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"h", "*", 
             RowBox[{"f", "[", 
              RowBox[{"y", ",", "z"}], "]"}]}], ",", 
            RowBox[{"h", "*", 
             RowBox[{"g", "[", 
              RowBox[{"y", ",", "z", ",", "x"}], "]"}]}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"k2y", ",", "k2z"}], "}"}], "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"h", "*", 
             RowBox[{"f", "[", 
              RowBox[{
               RowBox[{"y", "+", 
                FractionBox["k1y", "2"]}], ",", 
               RowBox[{"z", "+", 
                FractionBox["k1z", "2"]}]}], "]"}]}], ",", 
            RowBox[{"h", "*", 
             RowBox[{"g", "[", 
              RowBox[{
               RowBox[{"y", "+", 
                FractionBox["k1y", "2"]}], ",", 
               RowBox[{"z", "+", 
                FractionBox["k1z", "2"]}], ",", 
               RowBox[{"x", "+", 
                FractionBox["h", "2"]}]}], "]"}]}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"k3y", ",", "k3z"}], "}"}], "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"h", "*", 
             RowBox[{"f", "[", 
              RowBox[{
               RowBox[{"y", "+", 
                FractionBox["k2y", "2"]}], ",", 
               RowBox[{"z", "+", 
                FractionBox["k2z", "2"]}]}], "]"}]}], ",", 
            RowBox[{"h", "*", 
             RowBox[{"g", "[", 
              RowBox[{
               RowBox[{"y", "+", 
                FractionBox["k2y", "2"]}], ",", 
               RowBox[{"z", "+", 
                FractionBox["k2z", "2"]}], ",", 
               RowBox[{"x", "+", 
                FractionBox["h", "2"]}]}], "]"}]}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"k4y", ",", "k4z"}], "}"}], "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"h", "*", 
             RowBox[{"f", "[", 
              RowBox[{
               RowBox[{"y", "+", "k3y"}], ",", 
               RowBox[{"z", "+", "k3z"}]}], "]"}]}], ",", 
            RowBox[{"h", "*", 
             RowBox[{"g", "[", 
              RowBox[{
               RowBox[{"y", "+", "k3y"}], ",", 
               RowBox[{"z", "+", "k3z"}], ",", 
               RowBox[{"x", "+", "h"}]}], "]"}]}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"y", "=", 
          RowBox[{"y", "+", 
           FractionBox[
            RowBox[{"k1y", "+", 
             RowBox[{"2", "*", "k2y"}], "+", 
             RowBox[{"2", "*", "k3y"}], "+", "k4y"}], "6"]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"z", "=", 
          RowBox[{"z", "+", 
           FractionBox[
            RowBox[{"k1z", "+", 
             RowBox[{"2", "*", "k2z"}], "+", 
             RowBox[{"2", "*", "k3z"}], "+", "k4z"}], "6"]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"x", "=", 
          RowBox[{"x", "+", "h"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"result", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], ";"}]}], "]"}],
       ";", "\[IndentingNewLine]", "result"}]}], "]"}]}], ";"}]}], "Input",
