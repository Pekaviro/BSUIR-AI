Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"eulerMethod", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y0_", ",", "z0_"}], "}"}], ",", "h_", ",", "n_"}], "]"}], ":=",
    " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "=", "a"}], ",", 
       RowBox[{"y", "=", "y0"}], ",", 
       RowBox[{"z", "=", "z0"}], ",", 
       RowBox[{"result", "=", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], "}"}]}]}], "}"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"AppendTo", "[", 
       RowBox[{"result", ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], ";", " ", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", "n"}], ",", 
        RowBox[{"i", "++"}], ",", " ", 
        RowBox[{
         RowBox[{"y", "=", 
          RowBox[{"y", "+", 
           RowBox[{"h", "*", 
            RowBox[{"f", "[", 
             RowBox[{"y", ",", "z"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"z", "=", 
          RowBox[{"z", "+", 
           RowBox[{"h", "*", 
            RowBox[{"g", "[", 
             RowBox[{"y", ",", "z", ",", "x"}], "]"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"x", "=", 
          RowBox[{"x", "+", "h"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"result", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], ";"}]}], "]"}],
       ";", "\[IndentingNewLine]", "result"}]}], "]"}]}], ";"}]], "Input",
