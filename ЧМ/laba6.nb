Cell["\<\
\:0432) \:0420\:0435\:0448\:0438\:043c \:0434\:0430\:043d\:043d\:0443\:044e \
\:0437\:0430\:0434\:0430\:0447\:0443 \:041a\:043e\:0448\:0438 \:0441 \:043f\
\:043e\:043c\:043e\:0449\:044c\:044e \:0444\:0443\:043d\:043a\:0446\:0438\
\:0439 DSolve \:0438 NDSolve.\
\>", "Text",
 CellChangeTimes->{{3.942498491606577*^9, 
  3.9424984935697575`*^9}},ExpressionUUID->"1d76e89b-c1a1-8345-afd4-\
251198a32e36"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"y", ",", "z"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq1", " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"y", "'"}], "[", "x", "]"}], "+", 
     RowBox[{"5", 
      RowBox[{"z", "[", "x", "]"}]}], "-", 
     RowBox[{"4", 
      RowBox[{"y", "[", "x", "]"}]}]}], "==", "0"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"z", "'"}], "[", "x", "]"}], "-", 
     RowBox[{"3", 
      RowBox[{"y", "[", "x", "]"}]}], "+", 
     RowBox[{"4", 
      RowBox[{"z", "[", "x", "]"}]}]}], "==", "0"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"initialConditions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"y", "[", "0", "]"}], "==", "2.5"}], ",", 
     RowBox[{
      RowBox[{"z", "[", "0", "]"}], "==", "1"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solD", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eq1", ",", "eq2", ",", "initialConditions"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"y", ",", "z"}], "}"}], ",", " ", "x"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"grD", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "[", "x", "]"}], "/.", 
       RowBox[{"solD", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"z", "[", "x", "]"}], "/.", 
       RowBox[{"solD", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
    RowBox[{"ImageSize", "->", "Small"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9424985318169937`*^9, 3.942498645939516*^9}, {
   3.9425022458037605`*^9, 3.942502321344637*^9}, {3.942502351352186*^9, 
